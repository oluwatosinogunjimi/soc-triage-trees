{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OSINT tools",
  "description": "Verified OSINT tools for SOC checks, shown on the OSINT page. Edited by hand in osint/tools.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tools"],
  "properties": {
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "url", "group", "what", "use_when", "opsec", "access", "playbooks", "verified"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://[^\\s{}]+$" },
          "group": { "enum": ["reputation", "infrastructure", "sandbox", "email", "vulnerability", "reference", "utility"] },
          "what": { "type": "string", "minLength": 1 },
          "use_when": { "type": "string", "minLength": 1 },
          "watch_out": { "type": "string" },
          "opsec": { "enum": ["local", "lookup", "submits"] },
          "access": { "enum": ["free", "free-account", "freemium", "paid"] },
          "lookups": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "patternProperties": {
              "^(ip|domain|url|hash|sha256|cve)$": { "type": "string", "pattern": "^https://[^\\s]*\\{(value|urlsha256)\\}[^\\s]*$" }
            }
          },
          "playbooks": { "type": "array", "items": { "type": "string" } },
          "verified": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "how"],
            "properties": {
              "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "how": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
